      "source": [
        "# ============================================================\n",
        "# CELL 7: Core Pipeline Function (identical logic applied to every language)\n",
        "# ============================================================\n",
        "# This is the SAME validated pipeline from the Hindi-only study: TF-IDF (uni+bi-gram)\n",
        "# -> validation-tuned MNB (alpha) and LR (C, class_weight) -> single-split test\n",
        "# evaluation -> 5-fold stratified CV on train+valid -> paired t-test (MNB vs LR).\n",
        "\n",
        "def run_language_pipeline(language_name, df_train, df_valid, df_test):\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(f\"  PIPELINE: {language_name}\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    X_train, y_train = df_train['text_clean'].values, df_train['sentiment'].values\n",
        "    X_valid, y_valid = df_valid['text_clean'].values, df_valid['sentiment'].values\n",
        "    X_test, y_test = df_test['text_clean'].values, df_test['sentiment'].values\n",
        "\n",
        "    # ---- TF-IDF (fit on train only) ----\n",
        "    tfidf = TfidfVectorizer(ngram_range=(1, 2), max_df=0.95, min_df=2,\n",
        "                             sublinear_tf=True, norm='l2')\n",
        "    Xtr = tfidf.fit_transform(X_train)\n",
        "    Xv = tfidf.transform(X_valid)\n",
        "    Xte = tfidf.transform(X_test)\n",
        "    print(f\"  Vocabulary size: {len(tfidf.vocabulary_)}\")\n",
        "\n",
        "    # ---- Hyperparameter tuning on validation set ----\n",
        "    best_alpha, best_val_acc_nb = 1.0, -1\n",
        "    for a in [0.01, 0.02, 0.05, 0.1, 0.2, 0.5, 1.0]:\n",
        "        m = MultinomialNB(alpha=a)\n",
        "        m.fit(Xtr, y_train)\n",
        "        acc = accuracy_score(y_valid, m.predict(Xv))\n",
        "        if acc > best_val_acc_nb:\n",
        "            best_val_acc_nb, best_alpha = acc, a\n",
        "\n",
        "    best_C, best_cw, best_val_acc_lr = 1.0, None, -1\n",
        "    for cw in [None, 'balanced']:\n",
        "        for c in [0.5, 1.0, 3.0, 5.0, 10.0]:\n",
        "            m = LogisticRegression(solver='lbfgs', max_iter=2000, random_state=RANDOM_STATE,\n",
        "                                    n_jobs=-1, C=c, class_weight=cw)\n",
        "            m.fit(Xtr, y_train)\n",
        "            acc = accuracy_score(y_valid, m.predict(Xv))\n",
        "            if acc > best_val_acc_lr:\n",
        "                best_val_acc_lr, best_C, best_cw = acc, c, cw\n",
        "\n",
        "    print(f\"  Best MNB: alpha={best_alpha} (val acc={best_val_acc_nb:.4f})\")\n",
        "    print(f\"  Best LR:  C={best_C}, class_weight={best_cw} (val acc={best_val_acc_lr:.4f})\")\n",
        "\n",
        "    # ---- Final models on full training data ----\n",
        "    mnb = MultinomialNB(alpha=best_alpha)\n",
        "    mnb.fit(Xtr, y_train)\n",
        "    lr = LogisticRegression(solver='lbfgs', max_iter=2000, random_state=RANDOM_STATE,\n",
        "                             n_jobs=-1, C=best_C, class_weight=best_cw)\n",
        "    lr.fit(Xtr, y_train)\n",
        "\n",
        "    y_pred_mnb = mnb.predict(Xte)\n",
        "    y_pred_lr = lr.predict(Xte)\n",
        "\n",
        "    results = {\n",
        "        'language': language_name,\n",
        "        'vocab_size': len(tfidf.vocabulary_),\n",
        "        'best_alpha': best_alpha, 'best_C': best_C, 'best_class_weight': best_cw,\n",
        "        'MNB': {\n",
        "            'test_acc': accuracy_score(y_test, y_pred_mnb),\n",
        "            'test_prec': precision_score(y_test, y_pred_mnb, average='macro', zero_division=0),\n",
        "            'test_rec': recall_score(y_test, y_pred_mnb, average='macro', zero_division=0),\n",
        "            'test_f1': f1_score(y_test, y_pred_mnb, average='macro', zero_division=0),\n",
        "            'report': classification_report(y_test, y_pred_mnb, output_dict=True, zero_division=0),\n",
        "            'confusion_matrix': confusion_matrix(y_test, y_pred_mnb).tolist(),\n",
        "        },\n",
        "        'LR': {\n",
        "            'test_acc': accuracy_score(y_test, y_pred_lr),\n",
        "            'test_prec': precision_score(y_test, y_pred_lr, average='macro', zero_division=0),\n",
        "            'test_rec': recall_score(y_test, y_pred_lr, average='macro', zero_division=0),\n",
        "            'test_f1': f1_score(y_test, y_pred_lr, average='macro', zero_division=0),\n",
        "            'report': classification_report(y_test, y_pred_lr, output_dict=True, zero_division=0),\n",
        "            'confusion_matrix': confusion_matrix(y_test, y_pred_lr).tolist(),\n",
        "        },\n",
        "    }\n",
        "\n",
        "    print(f\"\\n  Test Accuracy -> MNB: {results['MNB']['test_acc']*100:.2f}%  \"\n",
        "          f\"LR: {results['LR']['test_acc']*100:.2f}%\")\n",
        "    print(f\"  Test Macro-F1 -> MNB: {results['MNB']['test_f1']:.4f}  \"\n",
        "          f\"LR: {results['LR']['test_f1']:.4f}\")\n",
        "\n",
        "    # ---- 5-fold stratified CV on combined train+valid ----\n",
        "    df_dev = pd.concat([df_train, df_valid], ignore_index=True)\n",
        "    X_dev, y_dev = df_dev['text_clean'].values, df_dev['sentiment'].values\n",
        "    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
        "\n",
        "    cv_acc = {'MNB': [], 'LR': []}\n",
        "    for tr_idx, va_idx in skf.split(X_dev, y_dev):\n",
        "        Xf_tr, Xf_va = X_dev[tr_idx], X_dev[va_idx]\n",
        "        yf_tr, yf_va = y_dev[tr_idx], y_dev[va_idx]\n",
        "        tfidf_f = TfidfVectorizer(ngram_range=(1, 2), max_df=0.95, min_df=2,\n",
        "                                   sublinear_tf=True, norm='l2')\n",
        "        Xf_tr_t = tfidf_f.fit_transform(Xf_tr)\n",
        "        Xf_va_t = tfidf_f.transform(Xf_va)\n",
        "\n",
        "        m_nb = MultinomialNB(alpha=best_alpha)\n",
        "        m_nb.fit(Xf_tr_t, yf_tr)\n",
        "        cv_acc['MNB'].append(accuracy_score(yf_va, m_nb.predict(Xf_va_t)))\n",
        "\n",
        "        m_lr = LogisticRegression(solver='lbfgs', max_iter=2000, random_state=RANDOM_STATE,\n",
        "                                   n_jobs=-1, C=best_C, class_weight=best_cw)\n",
        "        m_lr.fit(Xf_tr_t, yf_tr)\n",
        "        cv_acc['LR'].append(accuracy_score(yf_va, m_lr.predict(Xf_va_t)))\n",
        "\n",
        "    results['MNB']['cv_acc_mean'] = float(np.mean(cv_acc['MNB']))\n",
        "    results['MNB']['cv_acc_std'] = float(np.std(cv_acc['MNB']))\n",
        "    results['LR']['cv_acc_mean'] = float(np.mean(cv_acc['LR']))\n",
        "    results['LR']['cv_acc_std'] = float(np.std(cv_acc['LR']))\n",
        "\n",
        "    t_stat, p_val = stats.ttest_rel(cv_acc['LR'], cv_acc['MNB'])\n",
        "    results['ttest_t'] = float(t_stat)\n",
        "    results['ttest_p'] = float(p_val)\n",
        "\n",
        "    nb_cv_mean = results['MNB']['cv_acc_mean'] * 100\n",
        "    nb_cv_std = results['MNB']['cv_acc_std'] * 100\n",
        "    lr_cv_mean = results['LR']['cv_acc_mean'] * 100\n",
        "    lr_cv_std = results['LR']['cv_acc_std'] * 100\n",
        "    print(f\"\\n  5-Fold CV Accuracy -> MNB: {nb_cv_mean:.2f}% +/- {nb_cv_std:.2f}%  \"\n",
        "          f\"LR: {lr_cv_mean:.2f}% +/- {lr_cv_std:.2f}%\")\n",
        "    print(f\"  Paired t-test (LR vs MNB): t={t_stat:.4f}, p={p_val:.4f}\")\n",
        "\n",
        "    print(f\"\\n  --- MNB Classification Report ({language_name}, Test Set) ---\")\n",
        "    print(classification_report(y_test, y_pred_mnb, zero_division=0))\n",
        "    print(f\"  --- LR Classification Report ({language_name}, Test Set) ---\")\n",
        "    print(classification_report(y_test, y_pred_lr, zero_division=0))\n",
        "\n",
        "    return results, tfidf, mnb, lr\n",
        "\n",
        "print(\"Pipeline function defined. Ready to run per language.\")\n"
      ]
