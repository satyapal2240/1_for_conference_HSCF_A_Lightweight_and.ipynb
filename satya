        "# ============================================================\n",
        "# CELL 17: Reusable mBERT Fine-Tuning Function (identical logic per language)\n",
        "# ============================================================\n",
        "from transformers import (\n",
        "    AutoTokenizer, AutoModelForSequenceClassification,\n",
        "    Trainer, TrainingArguments\n",
        ")\n",
        "from sklearn.utils.class_weight import compute_class_weight\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import Dataset\n",
        "import numpy as np # Import numpy for arange and other operations\n",
        "\n",
        "MODEL_NAME = \"bert-base-multilingual-cased\"   # mBERT: same model for all 3 languages\n",
        "MAX_LEN = 128\n",
        "\n",
        "class SentimentDataset(Dataset):\n",
        "    def __init__(self, texts, labels, tokenizer, label2id, max_len=MAX_LEN):\n",
        "        self.texts = list(texts)\n",
        "        self.labels = [label2id[l] for l in labels]\n",
        "        self.tokenizer = tokenizer\n",
        "        self.max_len = max_len\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.texts)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        enc = self.tokenizer(self.texts[idx], truncation=True, max_length=self.max_len,\n",
        "                              padding='max_length', return_tensors='pt')\n",
        "        item = {k: v.squeeze(0) for k, v in enc.items()}\n",
        "        item['labels'] = torch.tensor(self.labels[idx], dtype=torch.long)\n",
        "        return item\n",
        "\n",
        "def make_weighted_trainer_class(class_weights_tensor):\n",
        "    class WeightedTrainer(Trainer):\n",
        "        def compute_loss(self, model, inputs, return_outputs=False, **kwargs):\n",
        "            labels = inputs.pop('labels')\n",
        "            outputs = model(**inputs)\n",
        "            logits = outputs.logits\n",
        "            loss_fct = nn.CrossEntropyLoss(weight=class_weights_tensor.to(logits.device))\n",
        "            loss = loss_fct(logits, labels)\n",
        "            return (loss, outputs) if return_outputs else loss\n",
        "    return WeightedTrainer\n",
        "\n",
        "def compute_metrics_fn(eval_pred):\n",
        "    logits, labels = eval_pred\n",
        "    preds = np.argmax(logits, axis=-1)\n",
        "    return {\n",
        "        'accuracy': accuracy_score(labels, preds),\n",
        "        'f1_macro': f1_score(labels, preds, average='macro'),\n",
        "        'precision_macro': precision_score(labels, preds, average='macro', zero_division=0),\n",
        "        'recall_macro': recall_score(labels, preds, average='macro', zero_division=0),\n",
        "    }\n",
        "\n",
        "def run_mbert_pipeline(language_name, df_train, df_valid, df_test, epochs=4, batch_size=16):\n",
        "    print(\"\\n\" + \"=\" * 70)\n",
        "    print(f\"  mBERT PIPELINE: {language_name}\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    classes = sorted(df_train['sentiment'].unique())\n",
        "    label2id = {c: i for i, c in enumerate(classes)}\n",
        "    id2label = {i: c for c, i in label2id.items()}\n",
        "    print(f\"  Classes: {label2id}\")\n",
        "\n",
        "    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
        "    model = AutoModelForSequenceClassification.from_pretrained(\n",
        "        MODEL_NAME, num_labels=len(classes), id2label=id2label, label2id=label2id\n",
        "    )\n",
        "\n",
        "    train_ds = SentimentDataset(df_train['text_clean'], df_train['sentiment'], tokenizer, label2id)\n",
        "    valid_ds = SentimentDataset(df_valid['text_clean'], df_valid['sentiment'], tokenizer, label2id)\n",
        "    test_ds = SentimentDataset(df_test['text_clean'], df_test['sentiment'], tokenizer, label2id)\n",
        "    print(f\"  Train: {len(train_ds)}  Valid: {len(valid_ds)}  Test: {len(test_ds)}\")\n",
        "\n",
        "    train_labels_int = [label2id[l] for l in df_train['sentiment']]\n",
        "    class_weights = compute_class_weight('balanced', classes=np.arange(len(classes)),\n",
        "                                          y=np.array(train_labels_int))\n",
        "    class_weights_tensor = torch.tensor(class_weights, dtype=torch.float)\n",
        "    print(f\"  Class weights: {dict(zip(classes, class_weights.round(3)))}\")\n",
        "\n",
        "    WeightedTrainer = make_weighted_trainer_class(class_weights_tensor)\n",
        "\n",
        "    # Calculate total training steps to determine warmup_steps\n",
        "    total_train_steps = int(len(train_ds) / batch_size * epochs)\n",
        "    warmup_steps = int(total_train_steps * 0.1) # 10% of total steps for warmup\n",
        "\n",
        "    training_args = TrainingArguments(\n",
        "        output_dir=f'./mbert_{language_name.lower()}',\n",
        "        num_train_epochs=epochs,\n",
        "        per_device_train_batch_size=batch_size,\n",
        "        per_device_eval_batch_size=32,\n",
        "        learning_rate=2e-5,\n",
        "        weight_decay=0.01,\n",
        "        warmup_steps=warmup_steps, # Changed from warmup_ratio to warmup_steps\n",
        "        eval_strategy='epoch',\n",
        "        save_strategy='epoch',\n",
        "        load_best_model_at_end=True,\n",
        "        metric_for_best_model='f1_macro',\n",
        "        greater_is_better=True,\n",
        "        logging_steps=50,\n",
        "        report_to='none',\n",
        "        seed=RANDOM_STATE,\n",
        "    )\n",
        "\n",
        "    trainer = WeightedTrainer(model=model, args=training_args, train_dataset=train_ds,\n",
        "                               eval_dataset=valid_ds, compute_metrics=compute_metrics_fn)\n",
        "\n",
        "    trainer.train()\n",
        "\n",
        "    test_pred = trainer.predict(test_ds)\n",
        "    y_pred_int = np.argmax(test_pred.predictions, axis=-1)\n",
        "    y_true_int = [label2id[l] for l in df_test['sentiment']]\n",
        "\n",
        "    acc = accuracy_score(y_true_int, y_pred_int)\n",
        "    prec = precision_score(y_true_int, y_pred_int, average='macro', zero_division=0)\n",
        "    rec = recall_score(y_true_int, y_pred_int, average='macro', zero_division=0)\n",
        "    f1 = f1_score(y_true_int, y_pred_int, average='macro', zero_division=0)\n",
        "\n",
        "    print(f\"\\n  mBERT Test Results ({language_name}):\")\n",
        "    print(f\"    Accuracy: {acc*100:.2f}%  Precision: {prec:.4f}  Recall: {rec:.4f}  F1: {f1:.4f}\")\n",
        "    print(classification_report(y_true_int, y_pred_int,\n",
        "                                 target_names=[id2label[i] for i in range(len(classes))],\n",
        "                                 zero_division=0))\n",
        "\n",
        "    results = {\n",
        "        'language': language_name, 'test_acc': acc, 'test_prec': prec,\n",
        "        'test_rec': rec, 'test_f1': f1,\n",
        "        'report': classification_report(y_true_int, y_pred_int,\n",
        "                                         target_names=[id2label[i] for i in range(len(classes))],\n",
        "                                         output_dict=True, zero_division=0),\n",
        "        'confusion_matrix': confusion_matrix(y_true_int, y_pred_int).tolist(),\n",
        "        'label_order': [id2label[i] for i in range(len(classes))],\n",
        "    }\n",
        "    return results, trainer, tokenizer\n",
        "\n",
        "print(\"mBERT pipeline function defined.\")\n"
      ]
    },
