        "# ============================================================\n",
        "# CELL 3: Helper Functions (path resolution, preprocessing, column auto-detection)\n",
        "# ============================================================\n",
        "\n",
        "def resolve_path(filename):\n",
        "    \"\"\"Find a data file in common locations (Colab upload dir, local dir, etc.).\"\"\"\n",
        "    candidates = [f'/content/{filename}', f'/mnt/user-data/uploads/{filename}',\n",
        "                  f'./{filename}', filename]\n",
        "    for c in candidates:\n",
        "        if os.path.exists(c):\n",
        "            return c\n",
        "    raise FileNotFoundError(\n",
        "        f\"Could not find '{filename}'. Please upload it to /content/ (Colab) \"\n",
        "        f\"or place it in the notebook's working directory.\"\n",
        "    )\n",
        "\n",
        "def preprocess_text(text):\n",
        "    \"\"\"Minimal, script-agnostic cleaning: safe for Devanagari and Bengali script.\"\"\"\n",
        "    if pd.isna(text):\n",
        "        return \"\"\n",
        "    text = str(text)\n",
        "    text = text.replace('\\n', ' ').replace('\\r', ' ')\n",
        "    text = re.sub(r'http\\S+|www\\.\\S+', ' ', text)   # strip URLs (common in tweet data)\n",
        "    text = re.sub(r'@\\w+', ' ', text)                 # strip @mentions (common in tweet data)\n",
        "    text = ' '.join(text.split())\n",
        "    return text.strip()\n",
        "\n",
        "# Candidate column-name patterns to try, in priority order, for auto-detecting\n",
        "# the text and label columns in datasets whose exact schema is not known in advance.\n",
        "TEXT_COL_CANDIDATES = ['text', 'Text', 'TEXT', 'tweet', 'Tweet', 'sentence',\n",
        "                        'review', 'comment', 'content', 'Sentence']\n",
        "LABEL_COL_CANDIDATES = ['sentiment', 'Sentiment', 'SENTIMENT', 'label', 'Label',\n",
        "                         'LABEL', 'class', 'Class', 'target', 'Target']\n",
        "\n",
        "def load_labeled_csv(path, text_col_override=None, label_col_override=None,\n",
        "                      header_guess='infer'):\n",
        "    \"\"\"\n",
        "    Robustly load a sentiment CSV whose exact column names/header may be unknown.\n",
        "    Tries pandas' normal header inference first; if the resulting columns don't\n",
        "    match any known text/label pattern, retries assuming NO header with the\n",
        "    2-column (label, text) convention used by the Hindi files in this study.\n",
        "    Always prints what it found, so mismatches are caught immediately.\n",
        "    \"\"\"\n",
        "    df = pd.read_csv(path, on_bad_lines='skip')  # header='infer' by default\n",
        "    text_col = text_col_override\n",
        "    label_col = label_col_override\n",
        "\n",
        "    if text_col is None:\n",
        "        for c in TEXT_COL_CANDIDATES:\n",
        "            if c in df.columns:\n",
        "                text_col = c\n",
        "                break\n",
        "    if label_col is None:\n",
        "        for c in LABEL_COL_CANDIDATES:\n",
        "            if c in df.columns:\n",
        "                label_col = c\n",
        "                break\n",
        "\n",
        "    if text_col is None or label_col is None:\n",
        "        # Fallback: assume no header, 2 columns, (label, text) order — matches\n",
        "        # the Hindi files' convention (hi-train.csv etc.)\n",
        "        df = pd.read_csv(path, header=None, names=['sentiment', 'text'], on_bad_lines='skip')\n",
        "        text_col, label_col = 'text', 'sentiment'\n",
        "\n",
        "    print(f\"  Loaded: {os.path.basename(path)}  ->  shape={df.shape}, \"\n",
        "          f\"text_col='{text_col}', label_col='{label_col}'\")\n",
        "    print(f\"    Columns found: {list(df.columns)}\")\n",
        "    if label_col in df.columns:\n",
        "        print(f\"    Label distribution: {df[label_col].value_counts().to_dict()}\")\n",
        "\n",
        "    out = df[[label_col, text_col]].copy()\n",
        "    out.columns = ['sentiment', 'text']\n",
        "    out.dropna(inplace=True)\n",
        "    out['text_clean'] = out['text'].apply(preprocess_text)\n",
        "    return out\n",
        "\n",
        "print(\"Helper functions defined.\")\n"
